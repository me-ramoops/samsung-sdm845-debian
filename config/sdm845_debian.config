# Samsung SDM845 Debian Linux config fragment
CONFIG_LOCALVERSION="-sdm845-debian"

# Framebuffer & Display
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8=y
CONFIG_REGULATOR_S2DOS05=y

# USB Gadget & Network Lifeline
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# WiFi & Broadcom PCIe
CONFIG_PCI_MSM=y
CONFIG_PCIE_QCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# Maxim PMIC & Samsung Peripherals
CONFIG_MFD_MAX77705=y
CONFIG_CHARGER_MAX77705=m
CONFIG_BATTERY_MAX77705=m
CONFIG_LEDS_MAX77705=m
CONFIG_INPUT_MAX77693_HAPTIC=m
CONFIG_HWMON_MAX77705=m
CONFIG_TOUCHSCREEN_S6SY761=m

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SDM845=m
CONFIG_SND_SOC_WCD934X=m
CONFIG_SND_SOC_MAX98512=m

# Storage & Essential Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_F2FS_FS=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y

# Systemd & Container requirements
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_AUTOFS4_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Disable unrelated platforms to speed up build and avoid bugs
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_SYSC_RCAR is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_ALLWINNER is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_XGENE is not set

# RemoteProc: Qualcomm SDM845 DSPs only, disable non-Qualcomm
# CONFIG_IMX_REMOTEPROC is not set
# CONFIG_TI_K3_R5_REMOTEPROC is not set
# CONFIG_TI_K3_DSP_REMOTEPROC is not set
# CONFIG_KEYSTONE_REMOTEPROC is not set
# CONFIG_RCAR_REMOTEPROC is not set
# CONFIG_ST_SLIM_REMOTEPROC is not set

# Adreno GPU
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y
